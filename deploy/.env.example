# Copy to .env (chmod 600) and fill in what you use. Never commit the real file.

# Telegram bot (create one with @BotFather; get the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=123456789:replace-me
TELEGRAM_CHAT_ID=123456789

# E-mail via SMTP (STARTTLS)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-me
MAIL_FROM=alerts@example.com
MAIL_TO=you@example.com,colleague@example.com

# Generic webhook (Slack/Discord/n8n/Zapier/your own endpoint)
WEBHOOK_URL=https://hooks.example.com/endpoint
WEBHOOK_TOKEN=replace-me
